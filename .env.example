# -----------------------------------------------------------------------------
# Aplikasi vcp - Template Environment Variables (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# -----------------------------------------------------------------------------

# Konfigurasi Aplikasi
APP_NAME=vcp
# URL aplikasi. Kosongkan agar otomatis mendeteksi domain hosting atau localhost Anda.
# Contoh jika ingin dipaksa: APP_URL=https://domainanda.com
APP_URL=
APP_ENV=local

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vcp
DB_USER=root
DB_PASS=

# Konfigurasi AI (OpenAI-compatible API: OpenAI, OpenRouter, Groq, NVIDIA NIM, dll)
# Kosongkan AI_API_KEY jika ingin menjalankan dalam mode demo dengan template bawaan
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_MAX_TOKENS=8192
AI_THINKING=false
AI_TIMEOUT=28
AI_SSL_VERIFY=true

# Autentikasi OAuth Google (Kosongkan jika tidak dipakai)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autentikasi OAuth GitHub (Kosongkan jika tidak dipakai)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
